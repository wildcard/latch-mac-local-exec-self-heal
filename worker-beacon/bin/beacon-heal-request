#!/usr/bin/env python3
"""POST one heal request to the worker-beacon writer route.

This command stays on the operator worker host. It is not installed on the Mac.
The writer token is read from a file and is never printed, logged, or placed
in argv. Output is only an HTTP status (or dry-run) and the request id (jti).
"""
import json
import os
import re
import stat
import sys
import time
import urllib.error
import urllib.request
import uuid


DEFAULT_TOKEN_FILE = "/home/box/.secrets/latch-worker-beacon/WRITER_TOKEN"
MACHINE_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,128}$")
EXP_TTL_SEC = 60


def fail(message):
    sys.stderr.write(message + "\n")
    return 2


def https_url(url):
    if not isinstance(url, str) or not url.startswith("https://"):
        return False
    rest = url[len("https://"):]
    if not rest or rest.startswith("/") or any(ch in rest for ch in " \t\r\n"):
        return False
    host = rest.split("/", 1)[0]
    if not host or "@" in host:
        return False
    return True


def read_token(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        raise ValueError("token file unreadable")
    with os.fdopen(fd) as handle:
        st = os.fstat(handle.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_mode & 0o077:
            raise ValueError("token file perms too open")
        raw = handle.read(4096)
    if len(raw) >= 4096:
        raise ValueError("token file unreadable")
    token = raw.replace("\r", "").replace("\n", "")
    if not token or any(ch in token for ch in "\x00"):
        raise ValueError("token file unreadable")
    return token


def build_body(machine_id, jti, now):
    return {
        "v": 1,
        "action": "heal_request",
        "machineId": machine_id,
        "jti": jti,
        "exp": int(now) + EXP_TTL_SEC,
    }


def post_json(url, token, body):
    data = json.dumps(body).encode("utf-8")
    request = urllib.request.Request(
        url.rstrip("/") + "/v1/heal-request",
        data=data,
        method="POST",
        headers={
            "authorization": "Bearer " + token,
            "content-type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return response.status
    except urllib.error.HTTPError as exc:
        return exc.code


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    dry_run = False
    if "--dry-run" in argv:
        dry_run = True
        argv = [arg for arg in argv if arg != "--dry-run"]
    if len(argv) != 1 or MACHINE_RE.fullmatch(argv[0]) is None:
        return fail("usage: beacon-heal-request [--dry-run] MACHINE_ID")
    machine_id = argv[0]
    url = os.environ.get("BEACON_URL", "")
    if not https_url(url):
        return fail("BEACON_URL must be https")
    token_path = os.environ.get("BEACON_WRITER_TOKEN_FILE") or DEFAULT_TOKEN_FILE
    try:
        token = read_token(token_path)
    except ValueError as exc:
        return fail(str(exc))
    jti = str(uuid.uuid4())
    body = build_body(machine_id, jti, time.time())
    if dry_run:
        sys.stdout.write("dry-run %s\n" % jti)
        return 0
    try:
        status = post_json(url, token, body)
    except Exception:
        return fail("request failed")
    sys.stdout.write("%s %s\n" % (status, jti))
    return 0 if 200 <= status < 300 else 1


if __name__ == "__main__":
    sys.exit(main())
